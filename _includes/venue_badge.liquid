{% assign venue = include.venue %}
{% if venue %}
  {% if site.data.venues[venue] %}
    {% assign venue_style = null %}
    {% if site.data.venues[venue].color != blank %}
      {% assign venue_style = site.data.venues[venue].color | prepend: 'style="background-color:' | append: '"' %}
    {% endif %}
    <abbr
      class="badge rounded w-100"
      {% if venue_style %}
        {{ venue_style }}
      {% endif %}
    >
      {% if site.data.venues[venue].url %}
        <a href="{{ site.data.venues[venue].url }}">{{ venue }}</a>
      {% else %}
        <div>{{ venue }}</div>
      {% endif %}
    </abbr>
  {% else %}
    <abbr class="badge rounded w-100">{{ venue }}</abbr>
  {% endif %}
{% endif %}
